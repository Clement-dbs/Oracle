# --- MinIO ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false # true pour client HTTPS sinon false pour client HTTP

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333

# --- Redis (mémoire conversation) ---
REDIS_URL=redis://redis:6379

# --- Ollama ---
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:14b

# --- Embeddings ---
EMBEDDINGS_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
EMBEDDINGS_MODEL_LOCAL_PATH=/app/embeddings_models/bge-m3
RERANKER_LOCAL_PATH=/app/embeddings_models/bge-reranker-v2-m3

# HuggingFace -> 1 = Empeche d'appeler le Hub (vérifie si le model d'embedding est à jour)
TRANSFORMERS_OFFLINE=0
HF_DATASETS_OFFLINE=0

# --- LeCockpittt (synchro Mongo -> RAG, app/cockpittt/mongo_sync.py) ---
LECOCKPITTT_API_URL=
LECOCKPITTT_API_KEY=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_ALLOWED_DOMAIN=strattt.com
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8001/auth/google/callback
